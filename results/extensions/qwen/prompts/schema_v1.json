{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "qwen_inspect_v1",
  "title": "qwen_inspect_v1 output schema",
  "type": "object",
  "required": ["decision", "anomaly_score", "confidence", "defect_type", "evidence", "regions"],
  "additionalProperties": false,
  "properties": {
    "decision": {"type": "string", "enum": ["OK", "NG", "UNCERTAIN"]},
    "anomaly_score": {"type": "number", "minimum": 0.0, "maximum": 1.0},
    "confidence": {"type": "number", "minimum": 0.0, "maximum": 1.0},
    "defect_type": {"type": "string"},
    "evidence": {"type": "string"},
    "regions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["bbox_xyxy", "score"],
        "additionalProperties": false,
        "properties": {
          "bbox_xyxy": {
            "type": "array", "minItems": 4, "maxItems": 4,
            "items": {"type": "number", "minimum": 0.0, "maximum": 1.0}
          },
          "score": {"type": "number", "minimum": 0.0, "maximum": 1.0}
        }
      }
    }
  }
}
